page 4 (
    name: Employee Form
    alias: EMPLOYEE-FORM
    title: Employee Form
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region employee-form (
        name: Employee Form
        type: form
        source {
            location: localDatabase
            tableName: HR_EMPLOYEES
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P4_CREATED_AT (
        type: datePicker
        label {
            label: Created At
            alignment: right
        }
        layout {
            sequence: 110
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee-form
            column: CREATED_AT
            dataType: timestamp
        }
    )

    pageItem P4_DATE_OF_BIRTH (
        type: datePicker
        label {
            label: Date Of Birth
            alignment: right
        }
        layout {
            sequence: 70
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @employee-form
            column: DATE_OF_BIRTH
            dataType: date
        }
    )

    pageItem P4_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 50
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @employee-form
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P4_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @employee-form
            slot: regionBody
        }
        source {
            formRegion: @employee-form
            column: EMPLOYEE_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P4_EMPLOYEE_NUMBER (
        type: textField
        label {
            label: Employee Number
            alignment: right
        }
        layout {
            sequence: 20
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @employee-form
            column: EMPLOYEE_NUMBER
            dataType: varchar2
        }
    )

    pageItem P4_EMPLOYMENT_STATUS (
        type: textField
        label {
            label: Employment Status
            alignment: right
        }
        layout {
            sequence: 100
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @employee-form
            column: EMPLOYMENT_STATUS
            dataType: varchar2
        }
    )

    pageItem P4_FIRST_NAME (
        type: textField
        label {
            label: First Name
            alignment: right
        }
        layout {
            sequence: 30
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @employee-form
            column: FIRST_NAME
            dataType: varchar2
        }
    )

    pageItem P4_GENDER (
        type: textField
        label {
            label: Gender
            alignment: right
        }
        layout {
            sequence: 90
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 10
        }
        source {
            formRegion: @employee-form
            column: GENDER
            dataType: varchar2
        }
    )

    pageItem P4_HIRE_DATE (
        type: datePicker
        label {
            label: Hire Date
            alignment: right
        }
        layout {
            sequence: 80
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 255
        }
        source {
            formRegion: @employee-form
            column: HIRE_DATE
            dataType: date
        }
    )

    pageItem P4_LAST_NAME (
        type: textField
        label {
            label: Last Name
            alignment: right
        }
        layout {
            sequence: 40
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 50
        }
        source {
            formRegion: @employee-form
            column: LAST_NAME
            dataType: varchar2
        }
    )

    pageItem P4_PHONE_NUMBER (
        type: textField
        label {
            label: Phone Number
            alignment: right
        }
        layout {
            sequence: 60
            region: @employee-form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 20
        }
        source {
            formRegion: @employee-form
            column: PHONE_NUMBER
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @employee-form
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @employee-form
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P4_EMPLOYEE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @employee-form
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_EMPLOYEE_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @employee-form
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_EMPLOYEE_ID
        }
    )

    validation p4-created-at-must-be-timestamp (
        name: P4_CREATED_AT must be timestamp
        execution {
            sequence: 100
        }
        validation {
            type: itemIsAValidTimestamp
            item: P4_CREATED_AT
        }
        error {
            errorMessage: #LABEL# must be a valid timestamp.
            associatedItem: @P4_CREATED_AT
        }
    )

    process initialize-form-employee-form (
        name: Initialize form Employee Form
        type: formInitialization
        formRegion: @employee-form
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 4451668952517931
        }
    )

    process process-form-employee-form (
        name: Process form Employee Form
        type: formAutoRowProcessing
        formRegion: @employee-form
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 4452012718517932
        }
    )

    branch (
        execution {
            sequence: 1
        }
        behavior {
            target: {
                page: 1
            }
        }
    )

)

