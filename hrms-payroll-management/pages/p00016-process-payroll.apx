page 16 (
    name: Process Payroll
    alias: PROCESS-PAYROLL
    title: Process Payroll
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    pageItem P16_PAYROLL_ID (
        type: hidden
        layout {
            sequence: 40
            slot: body
        }
    )

    button mark-paid (
        buttonName: MARK_PAID
        label: Mark as Paid
        layout {
            sequence: 20
            slot: body
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button process (
        buttonName: PROCESS
        label: Process Payroll
        layout {
            sequence: 10
            slot: body
            startNewRow: false
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process execute-mark-payroll-paid (
        name: Execute Mark Payroll Paid
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                
                BEGIN
                    IF :P16_PAYROLL_ID IS NULL
                       OR NOT REGEXP_LIKE(:P16_PAYROLL_ID, '^[0-9]+$')
                    THEN
                        RAISE_APPLICATION_ERROR(
                            -20041,
                            'Invalid payroll ID. Return to Payroll Management and select a record.'
                        );
                    END IF;
                
                    MARK_PAYROLL_PAID(
                        p_payroll_id => TO_NUMBER(:P16_PAYROLL_ID)
                    );
                END;
                
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Payroll marked as paid successfully.
        }
        advanced {
            executionMappingIdentifier: 4488432251628420
        }
        serverSideCondition {
            whenButtonPressed: @mark-paid
        }
    )

    process execute-payroll-processing (
        name: Execute Payroll Processing
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                BEGIN
                    IF :P16_PAYROLL_ID IS NULL
                       OR NOT REGEXP_LIKE(:P16_PAYROLL_ID, '^[0-9]+$')
                    THEN
                        RAISE_APPLICATION_ERROR(
                            -20031,
                            'Invalid payroll ID. Return to Payroll Management and select a payroll record.'
                        );
                    END IF;
                
                    PROCESS_PAYROLL(
                        p_payroll_id => TO_NUMBER(:P16_PAYROLL_ID)
                    );
                END;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Payroll record processed successfully.
        }
        advanced {
            executionMappingIdentifier: 4488228922628418
        }
        serverSideCondition {
            whenButtonPressed: @process
        }
    )

)

